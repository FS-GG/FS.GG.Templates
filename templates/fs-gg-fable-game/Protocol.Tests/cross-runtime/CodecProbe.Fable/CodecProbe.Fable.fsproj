<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <EnableDefaultItems>false</EnableDefaultItems>
    <DefineConstants Condition="Exists('../../../SvgFoundation/ContinuousPlayer.fs')">$(DefineConstants);CONTINUOUS_PLAYER</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- Same source files CodecProbe.Net.fsproj compiles against Thoth.Json.Net,
         compiled here against Thoth.Json via dotnet fable; see
         ../../../Protocol/Protocol.fsproj's comment for why this is a Compile Include
         and not a project reference. -->
    <Compile Include="../../../Protocol/Http.fs" />
    <Compile Include="../../../Protocol/Realtime.fs" />
    <Compile Include="../../../Conformance/SceneSchema.fs" Link="SceneSchema.fs" />
    <Compile Include="../../../SvgFoundation/ContinuousPlayer.fs" Link="ContinuousPlayer.fs" Condition="Exists('../../../SvgFoundation/ContinuousPlayer.fs')" />
    <Compile Include="../Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../Domain/Domain.fsproj" />
    <PackageReference Include="Fable.Core" Version="[5.2.0]" />
    <PackageReference Include="Thoth.Json" Version="[10.5.1]" />
    <PackageReference Include="FS.GG.UI.Scene" Version="[0.31.0]" />
  </ItemGroup>
</Project>
