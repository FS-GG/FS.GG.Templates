<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="RoomAuthority.fs" />
    <Compile Include="GameHub.fs" />
    <Compile Include="Program.fs" />
    <Content Include="../Client/dist/**" Link="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Domain/Domain.fsproj" />
    <ProjectReference Include="../Protocol/Protocol.fsproj" />
  </ItemGroup>
</Project>
