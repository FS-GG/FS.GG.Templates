<Project Sdk="Microsoft.NET.Sdk">
  <!-- The .NET side of the shared wire boundary. Client/Client.fsproj compiles the
       same Http.fs / Realtime.fs source files (via a Compile Include, not a project
       reference) against Thoth.Json instead of Thoth.Json.Net, guarded by
       FABLE_COMPILER. Splitting the fsproj this way, rather than one shared fsproj
       referenced from both sides, is deliberate: a ProjectReference would drag this
       project's Thoth.Json.Net (a plain .NET package, not Fable-transpilable) into
       the Fable compile. See FS.GG.Game.Core's own Fable/*.fsproj for the same
       pattern applied to a NuGet-packed source view. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Http.fs" />
    <Compile Include="Realtime.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Thoth.Json.Net" Version="[12.0.0]" />
  </ItemGroup>
</Project>
