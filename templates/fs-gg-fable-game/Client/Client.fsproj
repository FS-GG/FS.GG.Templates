<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <EnableDefaultItems>false</EnableDefaultItems>
    <DefineConstants Condition="'$(FsGgSvgNetworkCandidate)' == 'true'">$(DefineConstants);SVG_NETWORK_CANDIDATE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- The same Protocol/*.fs source files Server/Server.fsproj compiles against
         Thoth.Json.Net are compiled here directly (a Compile Include, not a
         ProjectReference) against Thoth.Json, guarded by FABLE_COMPILER; see
         ../Protocol/Protocol.fsproj's comment for why. -->
    <Compile Include="../Protocol/Http.fs" />
    <Compile Include="../Protocol/Realtime.fs" />
    <Compile Include="SignalR.fs" />
    <Compile Include="Api.fs" />
    <Compile Include="Movement.fs" />
    <Compile Include="App.fs" />
    <Compile Include="Renderers.fs" />
    <Compile Include="Conformance.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <!-- 5.6.1 is the floor FS.GG.Game.Render.Browser 0.18.0 declares; this exact pin follows it. -->
    <PackageReference Include="Fable.Core" Version="[5.6.1]" />
    <PackageReference Include="Fable.Elmish" Version="[5.0.2]" />
    <PackageReference Include="Fable.Browser.Dom" Version="[2.20.0]" />
    <PackageReference Include="Thoth.Json" Version="[10.5.1]" />
    <!-- The published Game.Core Fable source profile (fs-gg-game-core-fable-lockstep-v1),
         consumed the same way Domain/Domain.fsproj does on the server: an ordinary
         package reference, never a sibling checkout, never a copied algorithm. `dotnet
         fable` resolves this PackageReference to the package's own bundled fable/*.fs
         source view (the Fable-package convention FS.GG.Game.Core's own package
         follows), not the compiled .NET assembly. Movement.fs calls
         `Pathfinding.astar` (LockstepExact) for a local path *preview* only; the
         server (Server/RoomAuthority.fs) remains the sole authority that commits
         movement. -->
    <PackageReference Include="FS.GG.Game.Core" Version="[$(FsGgGameVersion)]" />
    <!-- The three-adapter authoring path and its conformance kit (GAME-RENDER-ADOPT-01.10, FS.GG.Templates#834), both
         from nuget.org like every other package here. Each ships as Fable source: Render the renderer selection, the
         SceneRenderers declaration and RendererConformance; Render.Browser the SVG, PixiJS and BabylonJS surfaces, the
         RendererDriver, BrowserRenderers and BrowserConformance. Renderers.fs declares the game's renderers and
         Conformance.fs runs the kit; `renderers.html` is the page that loads it. The JavaScript the surfaces import
         (@babylonjs/core 9.33.1, pixi.js 8.22.0) is pinned in package.json beside this file, and only
         `renderers.html` reaches it: the game page never loads a renderer. -->
    <PackageReference Include="FS.GG.Game.Render" Version="[$(FsGgGameRenderVersion)]" />
    <PackageReference Include="FS.GG.Game.Render.Browser" Version="[$(FsGgGameRenderVersion)]" />
  </ItemGroup>
</Project>
