<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- This source-side characterization project shares a directory with the shipped
         player project and therefore cannot own that project's packages.lock.json. -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <RestoreLockedMode>false</RestoreLockedMode>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="TacticalCompatibility.fs" />
    <Compile Include="PreviewFont.fs" />
    <Compile Include="PreviewDocument.fs" />
    <Compile Include="TacticalCompatibility.Tests.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FS.GG.UI.Scene" Version="[0.30.0]" />
  </ItemGroup>
</Project>
