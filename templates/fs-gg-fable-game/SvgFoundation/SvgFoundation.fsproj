<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="LegacyPreview.props" Condition="Exists('LegacyPreview.props')" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <FsGgSvgInputVersion Condition="'$(FsGgSvgInputVersion)' == ''">0.31.0</FsGgSvgInputVersion>
    <FsGgGameRuntimeVersion Condition="'$(FsGgGameRuntimeVersion)' == ''">0.16.0</FsGgGameRuntimeVersion>
    <FsGgSvgInputCandidate Condition="'$(FsGgSvgInputCandidate)' == ''">true</FsGgSvgInputCandidate>
    <FsGgSvgRuntimeCandidate Condition="'$(FsGgSvgRuntimeCandidate)' == ''">true</FsGgSvgRuntimeCandidate>
    <FsGgSvgPresentCandidate Condition="'$(FsGgSvgPresentCandidate)' == ''">true</FsGgSvgPresentCandidate>
    <FsGgSvgScaleCandidate Condition="'$(FsGgSvgScaleCandidate)' == ''">true</FsGgSvgScaleCandidate>
    <FsGgAudioPresentVersion Condition="'$(FsGgAudioPresentVersion)' == ''">0.6.0</FsGgAudioPresentVersion>
    <DefineConstants Condition="'$(FsGgSvgInputCandidate)' == 'true'">$(DefineConstants);SVG_INPUT_CANDIDATE</DefineConstants>
    <DefineConstants Condition="'$(FsGgSvgRuntimeCandidate)' == 'true'">$(DefineConstants);SVG_RUNTIME_CANDIDATE</DefineConstants>
    <DefineConstants Condition="'$(FsGgSvgPresentCandidate)' == 'true'">$(DefineConstants);SVG_PRESENT_CANDIDATE</DefineConstants>
    <DefineConstants Condition="'$(FsGgSvgScaleCandidate)' == 'true'">$(DefineConstants);SVG_SCALE_CANDIDATE</DefineConstants>
    <DefineConstants Condition="'$(FsGgLegacyPreview)' == 'true'">$(DefineConstants);LEGACY_SVG_PREVIEW</DefineConstants>
    <DefineConstants Condition="Exists('Examples/Arcade/scene.json') and '$(FsGgSvgPresentCandidate)' == 'true'">$(DefineConstants);ARCADE_EXAMPLE</DefineConstants>
    <DefineConstants Condition="Exists('Examples/Tactical/scene.json')">$(DefineConstants);TACTICAL_EXAMPLE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Protocol/Http.fs" Link="Protocol/Http.fs" Condition="'$(FsGgLegacyPreview)' != 'true'" />
    <Compile Include="../Protocol/Realtime.fs" Link="Protocol/Realtime.fs" Condition="'$(FsGgLegacyPreview)' != 'true'" />
    <Compile Include="../Client/SignalR.fs" Link="Network/SignalR.fs" Condition="'$(FsGgLegacyPreview)' != 'true'" />
    <Compile Include="../Client/Api.fs" Link="Network/Api.fs" Condition="'$(FsGgLegacyPreview)' != 'true'" />
    <Compile Include="../Domain/ArenaContent.fs" Link="ArenaContent.fs" />
    <Compile Include="../Domain/ArcadeRules.fs" Link="ArcadeRules.fs" Condition="Exists('Examples/Arcade/scene.json') and '$(FsGgSvgPresentCandidate)' == 'true'" />
    <Compile Include="../Domain/Room.fs" Link="Room.fs" Condition="Exists('Examples/Tactical/scene.json')" />
    <Compile Include="../Domain/TacticalRules.fs" Link="TacticalRules.fs" Condition="Exists('Examples/Tactical/scene.json')" />
    <Compile Include="TacticalCompatibility.fs" Condition="'$(FsGgLegacyPreview)' == 'true'" />
    <Compile Include="../Conformance/GeneratedTacticalRuleModel.fs" Link="GeneratedTacticalRuleModel.fs" Condition="Exists('Examples/Tactical/scene.json')" />
    <Compile Include="PreviewFont.fs" Condition="'$(FsGgLegacyPreview)' == 'true'" />
    <Compile Include="PreviewDocument.fs" Condition="'$(FsGgLegacyPreview)' == 'true'" />
    <Compile Include="PlayerInput.fs" Condition="'$(FsGgSvgInputCandidate)' == 'true'" />
    <Compile Include="ContinuousPlayer.fs" Condition="'$(FsGgSvgRuntimeCandidate)' == 'true'" />
    <Compile Include="PresentationPlayer.fs" Condition="'$(FsGgSvgPresentCandidate)' == 'true'" />
    <Compile Include="ArcadeExample.fs" Condition="Exists('Examples/Arcade/scene.json') and '$(FsGgSvgPresentCandidate)' == 'true'" />
    <Compile Include="TacticalExample.fs" Condition="Exists('Examples/Tactical/scene.json')" />
    <Compile Include="SvgAuthority.fs" Condition="'$(FsGgSvgRuntimeCandidate)' == 'true' and '$(FsGgLegacyPreview)' != 'true'" />
    <Compile Include="ScalePlayer.fs" Condition="'$(FsGgSvgScaleCandidate)' == 'true'" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="[10.1.400]" />
    <PackageReference Include="Fable.Core" Version="[5.2.0]" />
    <PackageReference Include="Fable.Browser.Dom" Version="[2.20.0]" />
    <PackageReference Include="Thoth.Json" Version="[10.5.1]" />
    <PackageReference Include="FS.GG.UI.Scene" Version="[$(FsGgSvgInputVersion)]" />
    <PackageReference Include="FS.GG.UI.Scene.SvgBrowser" Version="[$(FsGgSvgInputVersion)]" />
    <PackageReference Include="FS.GG.UI.KeyboardInput" Version="[$(FsGgSvgInputVersion)]" Condition="'$(FsGgSvgInputCandidate)' == 'true'" />
    <PackageReference Include="FS.GG.Game.Core" Version="[$(FsGgGameRuntimeVersion)]" Condition="'$(FsGgSvgRuntimeCandidate)' == 'true'" />
    <PackageReference Include="FS.GG.Audio.Core" Version="[$(FsGgAudioPresentVersion)]" Condition="'$(FsGgSvgPresentCandidate)' == 'true'" />
    <PackageReference Include="FS.GG.Audio.WebBrowser" Version="[$(FsGgAudioPresentVersion)]" Condition="'$(FsGgSvgPresentCandidate)' == 'true'" />
  </ItemGroup>
</Project>
