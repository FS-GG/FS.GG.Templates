<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="LegacyPreview.props" Condition="Exists('LegacyPreview.props')" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <FsGgWasmPolicyExample Condition="'$(FsGgWasmPolicyExample)' == ''">false</FsGgWasmPolicyExample>
    <NuGetLockFilePath Condition="'$(FsGgWasmPolicyExample)' == 'true'">$(MSBuildProjectDirectory)/Examples/Wasm/packages.lock.json</NuGetLockFilePath>
    <DefineConstants Condition="'$(FsGgWasmPolicyExample)' == 'true' and Exists('Examples/Wasm/WasmPolicyExample.fs') and '$(FsGgLegacyPreview)' != 'true'">$(DefineConstants);WASM_POLICY_EXAMPLE</DefineConstants>
    <TargetFramework>net10.0</TargetFramework>
    <FsGgSvgInputVersion Condition="'$(FsGgSvgInputVersion)' == ''">0.32.1</FsGgSvgInputVersion>
    <!-- External authority reference requires explicit selection; the default player omits it. -->
    <FsGgExternalReferenceCandidate Condition="'$(FsGgExternalReferenceCandidate)' == ''">false</FsGgExternalReferenceCandidate>
    <FsGgGameRuntimeVersion Condition="'$(FsGgGameRuntimeVersion)' == ''">0.16.0</FsGgGameRuntimeVersion>
    <FsGgSvgInputCandidate Condition="'$(FsGgSvgInputCandidate)' == ''">true</FsGgSvgInputCandidate>
    <FsGgSvgRuntimeCandidate Condition="'$(FsGgSvgRuntimeCandidate)' == ''">true</FsGgSvgRuntimeCandidate>
    <FsGgSvgPresentCandidate Condition="'$(FsGgSvgPresentCandidate)' == ''">true</FsGgSvgPresentCandidate>
    <FsGgSvgScaleCandidate Condition="'$(FsGgSvgScaleCandidate)' == ''">true</FsGgSvgScaleCandidate>
    <FsGgAudioPresentVersion Condition="'$(FsGgAudioPresentVersion)' == ''">0.6.0</FsGgAudioPresentVersion>
    <DefineConstants Condition="'$(FsGgSvgInputCandidate)' == 'true'">$(DefineConstants);SVG_INPUT_CANDIDATE</DefineConstants>
    <DefineConstants Condition="'$(FsGgSvgRuntimeCandidate)' == 'true'">$(DefineConstants);SVG_RUNTIME_CANDIDATE</DefineConstants>
    <DefineConstants Condition="'$(FsGgSvgPresentCandidate)' == 'true'">$(DefineConstants);SVG_PRESENT_CANDIDATE</DefineConstants>
    <DefineConstants Condition="'$(FsGgSvgScaleCandidate)' == 'true'">$(DefineConstants);SVG_SCALE_CANDIDATE</DefineConstants>
    <DefineConstants Condition="'$(FsGgLegacyPreview)' == 'true'">$(DefineConstants);LEGACY_SVG_PREVIEW</DefineConstants>
    <DefineConstants Condition="Exists('Examples/Arcade/scene.json') and '$(FsGgSvgPresentCandidate)' == 'true'">$(DefineConstants);ARCADE_EXAMPLE</DefineConstants>
    <DefineConstants Condition="Exists('Examples/Tactical/scene.json')">$(DefineConstants);TACTICAL_EXAMPLE</DefineConstants>
    <DefineConstants Condition="Exists('Examples/ExternalAuthority/reference.json') and '$(FsGgExternalReferenceCandidate)' == 'true'">$(DefineConstants);EXTERNAL_AUTHORITY_REFERENCE</DefineConstants>
    <DefineConstants Condition="Exists('Examples/SoldierReference/reference.json') and '$(FsGgExternalReferenceCandidate)' == 'true' and '$(FsGgSvgRuntimeCandidate)' == 'true' and '$(FsGgSvgInputCandidate)' == 'true' and '$(FsGgLegacyPreview)' != 'true'">$(DefineConstants);SOLDIER_REFERENCE</DefineConstants>
    <DefineConstants Condition="Exists('Examples/FourD/LocalSaveReplayExample.fs') and '$(FsGgLegacyPreview)' != 'true'">$(DefineConstants);LOCAL_SAVE_REPLAY_EXAMPLE</DefineConstants>
    <DefineConstants Condition="Exists('Examples/FourD/reference.json')">$(DefineConstants);FOURD_REFERENCE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Protocol/Http.fs" Link="Protocol/Http.fs" Condition="'$(FsGgLegacyPreview)' != 'true'" />
    <Compile Include="../Protocol/Realtime.fs" Link="Protocol/Realtime.fs" Condition="'$(FsGgLegacyPreview)' != 'true'" />
    <Compile Include="../Client/SignalR.fs" Link="Network/SignalR.fs" Condition="'$(FsGgLegacyPreview)' != 'true'" />
    <Compile Include="../Client/Api.fs" Link="Network/Api.fs" Condition="'$(FsGgLegacyPreview)' != 'true'" />
    <Compile Include="../Domain/ArenaContent.fs" Link="ArenaContent.fs" />
    <Compile Include="../Domain/ArcadeRules.fs" Link="ArcadeRules.fs" Condition="Exists('Examples/Arcade/scene.json') and '$(FsGgSvgPresentCandidate)' == 'true'" />
    <Compile Include="../Domain/Room.fs" Link="Room.fs" Condition="Exists('Examples/Tactical/scene.json')" />
    <Compile Include="../Domain/TacticalRules.fs" Link="TacticalRules.fs" Condition="Exists('Examples/Tactical/scene.json')" />
    <Compile Include="TacticalCompatibility.fs" Condition="'$(FsGgLegacyPreview)' == 'true'" />
    <Compile Include="../Conformance/GeneratedTacticalRuleModel.fs" Link="GeneratedTacticalRuleModel.fs" Condition="Exists('Examples/Tactical/scene.json')" />
    <Compile Include="PreviewFont.fs" Condition="'$(FsGgLegacyPreview)' == 'true'" />
    <Compile Include="PreviewDocument.fs" Condition="'$(FsGgLegacyPreview)' == 'true'" />
    <Compile Include="PlayerInput.fs" Condition="'$(FsGgSvgInputCandidate)' == 'true'" />
    <Compile Include="ContinuousPlayer.fs" Condition="'$(FsGgSvgRuntimeCandidate)' == 'true'" />
    <Compile Include="PresentationPlayer.fs" Condition="'$(FsGgSvgPresentCandidate)' == 'true'" />
    <Compile Include="ArcadeExample.fs" Condition="Exists('Examples/Arcade/scene.json') and '$(FsGgSvgPresentCandidate)' == 'true'" />
    <Compile Include="TacticalExample.fs" Condition="Exists('Examples/Tactical/scene.json')" />
    <Compile Include="ExternalAuthorityReference.fs" Condition="Exists('Examples/ExternalAuthority/reference.json') and '$(FsGgExternalReferenceCandidate)' == 'true'" />
    <Compile Include="Examples/FourD/LocalSaveReplayExample.fs" Condition="Exists('Examples/FourD/LocalSaveReplayExample.fs') and '$(FsGgLegacyPreview)' != 'true'" />
    <Compile Include="FourDReference.fs" Condition="Exists('Examples/FourD/reference.json')" />
    <Compile Include="SvgAuthority.fs" Condition="'$(FsGgSvgRuntimeCandidate)' == 'true' and '$(FsGgLegacyPreview)' != 'true'" />
    <Compile Include="ScalePlayer.fs" Condition="'$(FsGgSvgScaleCandidate)' == 'true'" />
    <Compile Include="Examples/SoldierReference/SoldierWorkload.fs" Condition="Exists('Examples/SoldierReference/reference.json') and '$(FsGgExternalReferenceCandidate)' == 'true' and '$(FsGgSvgRuntimeCandidate)' == 'true' and '$(FsGgSvgInputCandidate)' == 'true' and '$(FsGgLegacyPreview)' != 'true'" />
    <Compile Include="Examples/SoldierReference/SoldierDocument.fs" Condition="Exists('Examples/SoldierReference/reference.json') and '$(FsGgExternalReferenceCandidate)' == 'true' and '$(FsGgSvgRuntimeCandidate)' == 'true' and '$(FsGgSvgInputCandidate)' == 'true' and '$(FsGgLegacyPreview)' != 'true'" />
    <Compile Include="SoldierReferenceLocal.fs" Condition="Exists('Examples/SoldierReference/reference.json') and '$(FsGgExternalReferenceCandidate)' == 'true' and '$(FsGgSvgRuntimeCandidate)' == 'true' and '$(FsGgSvgInputCandidate)' == 'true' and '$(FsGgLegacyPreview)' != 'true'" />
    <Compile Include="SoldierReferenceExternal.fs" Condition="Exists('Examples/SoldierReference/reference.json') and '$(FsGgExternalReferenceCandidate)' == 'true' and '$(FsGgSvgRuntimeCandidate)' == 'true' and '$(FsGgSvgInputCandidate)' == 'true' and '$(FsGgLegacyPreview)' != 'true'" />
    <Compile Include="SoldierReference.fs" Condition="Exists('Examples/SoldierReference/reference.json') and '$(FsGgExternalReferenceCandidate)' == 'true' and '$(FsGgSvgRuntimeCandidate)' == 'true' and '$(FsGgSvgInputCandidate)' == 'true' and '$(FsGgLegacyPreview)' != 'true'" />
    <Compile Include="Examples/Wasm/WasmPolicyExample.fs" Condition="'$(FsGgWasmPolicyExample)' == 'true'" />
    <Compile Include="Examples/Wasm/WasmPolicyBrowser.fs" Condition="'$(FsGgWasmPolicyExample)' == 'true'" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="[10.1.401]" />
    <PackageReference Include="FS.GG.Wasm.Contracts" Version="[0.3.0]" Condition="'$(FsGgWasmPolicyExample)' == 'true'" />
    <PackageReference Include="FS.GG.Wasm.Browser" Version="[0.3.0]" Condition="'$(FsGgWasmPolicyExample)' == 'true'" />
    <PackageReference Include="Fable.Core" Version="[5.3.0]" />
    <PackageReference Include="Fable.Browser.Dom" Version="[2.20.0]" />
    <PackageReference Include="Thoth.Json" Version="[10.5.1]" />
    <PackageReference Include="FS.GG.UI.Scene" Version="[$(FsGgSvgInputVersion)]" />
    <PackageReference Include="FS.GG.UI.Scene.SvgBrowser" Version="[$(FsGgSvgInputVersion)]" />
    <PackageReference Include="FS.GG.UI.KeyboardInput" Version="[$(FsGgSvgInputVersion)]" Condition="'$(FsGgSvgInputCandidate)' == 'true'" />
    <PackageReference Include="FS.GG.Game.Core" Version="[$(FsGgGameRuntimeVersion)]" Condition="'$(FsGgSvgRuntimeCandidate)' == 'true'" />
    <PackageReference Include="FS.GG.Audio.Core" Version="[$(FsGgAudioPresentVersion)]" Condition="'$(FsGgSvgPresentCandidate)' == 'true'" />
    <PackageReference Include="FS.GG.Audio.WebBrowser" Version="[$(FsGgAudioPresentVersion)]" Condition="'$(FsGgSvgPresentCandidate)' == 'true'" />
  </ItemGroup>
  <Target Name="ValidateWasmPolicySelection" BeforeTargets="CollectPackageReferences;Restore">
    <Error Condition="'$(FsGgWasmPolicyExample)' != 'false' and '$(FsGgWasmPolicyExample)' != 'true'" Text="FsGgWasmPolicyExample must be true or false." />
    <Error Condition="'$(FsGgWasmPolicyExample)' == 'true' and ('$(FsGgLegacyPreview)' == 'true' or !Exists('Examples/Wasm/WasmPolicyExample.fs'))" Text="WASM policy requires the nonlegacy Complete bundle." />
    <Error Condition="'$(FsGgWasmPolicyExample)' == 'true' and !Exists('Examples/Wasm/packages.lock.json') and !('$(FsGgWasmPolicyLockGeneration)' == 'true' and '$(RestoreLockedMode)' == 'false' and '$(RestoreForceEvaluate)' == 'true')" Text="WASM policy lock is missing. Use GenerateWasmPolicyLock, then qualify it before locked restore." />
    <Error Condition="'$(FsGgWasmPolicyLockGeneration)' == 'true' and ('$(RestoreLockedMode)' != 'false' or '$(RestoreForceEvaluate)' != 'true')" Text="Lock generation requires the explicit unlocked force-evaluated Restore context." />
  </Target>
  <!-- Generation performs Restore only; no project/Fable compilation is admitted by this target. -->
  <Target Name="GenerateWasmPolicyLock">
    <Error Condition="'$(FsGgWasmPolicyExample)' != 'true' or '$(FsGgLegacyPreview)' == 'true' or !Exists('Examples/Wasm/WasmPolicyExample.fs')" Text="Lock generation requires explicit nonlegacy Complete WASM selection." />
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Restore" Properties="FsGgWasmPolicyExample=true;FsGgWasmPolicyLockGeneration=true;RestoreLockedMode=false;RestoreForceEvaluate=true;RestorePackagesWithLockFile=true" />
    <Error Condition="!Exists('Examples/Wasm/packages.lock.json')" Text="Restore did not generate the actual opt-in lock." />
  </Target>
  <Target Name="ValidateWasmPolicyBuildLock" BeforeTargets="Build;CollectFableSources;CoreCompile">
    <Error Condition="'$(FsGgWasmPolicyExample)' != 'false' and '$(FsGgWasmPolicyExample)' != 'true'" Text="FsGgWasmPolicyExample must be true or false." />
    <Error Condition="'$(FsGgWasmPolicyExample)' == 'true' and ('$(FsGgLegacyPreview)' == 'true' or !Exists('Examples/Wasm/WasmPolicyExample.fs'))" Text="WASM policy requires the nonlegacy Complete bundle." />
    <Error Condition="'$(FsGgWasmPolicyExample)' == 'true' and !Exists('Examples/Wasm/packages.lock.json')" Text="WASM Build/Fable requires the genuine qualified opt-in lock; generation does not bypass this guard." />
  </Target>
</Project>
