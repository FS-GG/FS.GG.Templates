<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <RestoreLockedMode>false</RestoreLockedMode>
    <FsGgSvgAuthoringVersion Condition="'$(FsGgSvgAuthoringVersion)' == ''">0.30.0</FsGgSvgAuthoringVersion>
    <FsGgSvgInputCandidate Condition="'$(FsGgSvgInputCandidate)' == ''">true</FsGgSvgInputCandidate>
    <DefineConstants Condition="'$(FsGgSvgInputCandidate)' == 'true'">$(DefineConstants);SVG_INPUT_CANDIDATE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="SceneSchema.fs" />
    <Compile Include="WorkspaceInput.fs" Condition="'$(FsGgSvgInputCandidate)' == 'true'" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fable.Core" Version="[5.2.0]" />
    <PackageReference Include="Fable.Browser.Dom" Version="[2.20.0]" />
    <PackageReference Include="FS.GG.UI.Scene" Version="[$(FsGgSvgAuthoringVersion)]" />
    <PackageReference Include="FS.GG.UI.Scene.SvgBrowser" Version="[$(FsGgSvgAuthoringVersion)]" />
    <PackageReference Include="FS.GG.UI.KeyboardInput" Version="[$(FsGgSvgAuthoringVersion)]" Condition="'$(FsGgSvgInputCandidate)' == 'true'" />
  </ItemGroup>
</Project>
