<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <FsGgSvgAuthoringVersion Condition="'$(FsGgSvgAuthoringVersion)' == ''">0.31.0</FsGgSvgAuthoringVersion>
    <FsGgSvgInputCandidate Condition="'$(FsGgSvgInputCandidate)' == ''">true</FsGgSvgInputCandidate>
    <FsGgGameReplayVersion Condition="'$(FsGgGameReplayVersion)' == ''">0.16.0</FsGgGameReplayVersion>
    <FsGgSvgReplayCandidate Condition="'$(FsGgSvgReplayCandidate)' == ''">true</FsGgSvgReplayCandidate>
    <DefineConstants Condition="'$(FsGgSvgInputCandidate)' == 'true'">$(DefineConstants);SVG_INPUT_CANDIDATE</DefineConstants>
    <DefineConstants Condition="'$(FsGgSvgReplayCandidate)' == 'true'">$(DefineConstants);SVG_REPLAY_CANDIDATE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Domain/Room.fs" Link="Room.fs" />
    <Compile Include="../../Domain/ArenaContent.fs" Link="ArenaContent.fs" />
    <Compile Include="../../Domain/ArenaRules.fs" Link="ArenaRules.fs" />
    <Compile Include="../../Conformance/SceneSchema.fs" Link="SceneSchema.fs" />
    <Compile Include="WorkspaceInput.fs" Condition="'$(FsGgSvgInputCandidate)' == 'true'" />
    <Compile Include="../../Conformance/GeneratedArenaRuleModel.fs" Link="GeneratedArenaRuleModel.fs" Condition="'$(FsGgSvgReplayCandidate)' == 'true'" />
    <Compile Include="ReplayStudio.fs" Condition="'$(FsGgSvgReplayCandidate)' == 'true'" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="[10.1.400]" />
    <PackageReference Include="Fable.Core" Version="[5.2.0]" />
    <PackageReference Include="Fable.Browser.Dom" Version="[2.20.0]" />
    <PackageReference Include="FS.GG.UI.Scene" Version="[$(FsGgSvgAuthoringVersion)]" />
    <PackageReference Include="FS.GG.UI.Scene.SvgBrowser" Version="[$(FsGgSvgAuthoringVersion)]" />
    <PackageReference Include="FS.GG.UI.KeyboardInput" Version="[$(FsGgSvgAuthoringVersion)]" Condition="'$(FsGgSvgInputCandidate)' == 'true'" />
    <PackageReference Include="FS.GG.Game.Core" Version="[$(FsGgGameReplayVersion)]" Condition="'$(FsGgSvgReplayCandidate)' == 'true'" />
  </ItemGroup>
</Project>
