# syntax=docker/dockerfile:1.27
ARG ASPNET_RUNTIME_IMAGE=mcr.microsoft.com/dotnet/aspnet:11.0@sha256:68d8e392378201205434075873ef9d436e26031e81f446bf884b62b0956297ec
FROM ${ASPNET_RUNTIME_IMAGE}

ARG SVG_RELEASE_VERSION=workspace-v1
WORKDIR /app
COPY artifacts/releases/${SVG_RELEASE_VERSION}/authority-server/ ./

ENV ASPNETCORE_HTTP_PORTS=8080
EXPOSE 8080
USER $APP_UID
ENTRYPOINT ["dotnet", "Server.dll"]
