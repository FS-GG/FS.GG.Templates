{
  "name": "bindingsproduct-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "26.13.0",
    "npm": "12.2.1"
  },
  "dependencies": {
    "pixi.js": "8.22.0"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  },
  "scripts": {
    "build": "bash build.sh",
    "lock:declarations": "node scripts/lock-declarations.mjs --write",
    "check:drift": "node scripts/lock-declarations.mjs --check",
    "compile:fable": "dotnet fable tests/BindingsProduct.CompileTests/BindingsProduct.CompileTests.fsproj --outDir runtime/fable-dist --noCache",
    "test:side-effect-control": "node runtime/node/without-loader.mjs",
    "test:imports": "node runtime/node/smoke.mjs",
    "test:runtime": "node runtime/fable-dist/Program.js",
    "generate:candidate": "node scripts/generate-candidate.mjs",
    "xantham:prepare": "node scripts/prepare-xantham.mjs",
    "xantham:generate": "node scripts/generate-candidate.mjs --backend xantham",
    "xantham:assess": "node scripts/assess-xantham-updates.mjs",
    "test:browser": "node scripts/browser-smoke.mjs --page /runtime/browser/ --expect \"Pixi browser smoke passed\"",
    "test:lifecycle": "bash scripts/run-sdd-lifecycle.sh reports/bindings.junit.xml",
    "doctor": "node scripts/doctor.mjs"
  }
}
