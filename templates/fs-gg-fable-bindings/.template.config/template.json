{
  "$schema": "http://json.schemastore.org/template",
  "author": "FS-GG",
  "classifications": [ "F#", "Fable", "Interop", "Library", "Workspace" ],
  "identity": "FS.GG.Workspace.FableBindings",
  "name": "FS.GG Fable bindings workspace",
  "shortName": "fs-gg-fable-bindings",
  "preferNameDirectory": true,
  "symbols": {
    "productName": { "type": "parameter", "datatype": "text", "defaultValue": "", "description": "Binding/library name; --name is used when omitted." },
    "npmPackage": { "type": "parameter", "datatype": "text", "defaultValue": "", "replaces": "NpmPackage", "description": "Exact upstream npm package name." },
    "npmVersion": { "type": "parameter", "datatype": "text", "defaultValue": "", "replaces": "NpmVersion", "description": "Exact upstream npm package version (no range)." },
    "bindingTarget": { "type": "parameter", "datatype": "choice", "choices": [ { "choice": "browser" }, { "choice": "node" }, { "choice": "universal" } ], "defaultValue": "universal", "description": "Runtime evidence lane." },
    "productNameTrimmed": { "type": "generated", "generator": "regex", "dataType": "string", "parameters": { "source": "productName", "steps": [ { "regex": "^\\s+|\\s+$", "replacement": "" } ] } },
    "effectiveName": { "type": "generated", "generator": "coalesce", "parameters": { "sourceVariableName": "productNameTrimmed", "fallbackVariableName": "name" }, "replaces": "BindingsProduct", "fileRename": "BindingsProduct" },
    "rootNamespace": { "type": "parameter", "datatype": "text", "defaultValue": "", "description": "Optional valid F# identifier supplied by an SDD provider." },
    "rootNamespaceTrimmed": { "type": "generated", "generator": "regex", "dataType": "string", "parameters": { "source": "rootNamespace", "steps": [ { "regex": "^\\s+|\\s+$", "replacement": "" } ] } },
    "effectiveIdentifier": { "type": "generated", "generator": "coalesce", "parameters": { "sourceVariableName": "rootNamespaceTrimmed", "fallbackVariableName": "effectiveName" }, "replaces": "BindingsProductNamespace" }
  }
}
