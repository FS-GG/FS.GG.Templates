{
  "$schema": "http://json.schemastore.org/template",
  "author": "FS-GG",
  "classifications": [
    "go",
    "CLI",
    "Workspace"
  ],
  "identity": "FS.GG.Workspace.GoCli",
  "name": "FS-GG go CLI workspace",
  "shortName": "fs-gg-go-cli",
  "preferNameDirectory": true,
  "sources": [
    {
      "source": "./",
      "target": "./",
      "exclude": [
        "**/[Bb]in/**",
        "**/[Oo]bj/**",
        "**/.template.config/**",
        "**/*.filelist",
        "**/*.user",
        "**/node_modules/**",
        "**/.nuget/**",
        "**/target/**",
        "**/dist/**",
        "**/artifacts/**"
      ]
    }
  ],
  "symbols": {
    "rawName": {
      "type": "parameter",
      "datatype": "text",
      "isRequired": true,
      "description": "Human display name, independent of package and code identity.",
      "replaces": "Polyglot CLI display name"
    },
    "packageIdentity": {
      "type": "parameter",
      "datatype": "text",
      "isRequired": true,
      "description": "Explicit ecosystem package identity; Go requires a module path.",
      "replaces": "example.org/polyglot/product"
    },
    "codeIdentifier": {
      "type": "parameter",
      "datatype": "text",
      "isRequired": true,
      "description": "Explicit language-valid function identifier; no F# transform is applied.",
      "replaces": "polyglot_greet"
    }
  }
}
