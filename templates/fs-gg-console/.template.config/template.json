{
  "$schema": "http://json.schemastore.org/template",
  "author": "FS-GG",
  "classifications": [ "F#", "Console", "SDD", "Workspace" ],
  "identity": "FS.GG.Workspace.Console",
  "name": "FS.GG F# console workspace",
  "shortName": "fs-gg-console",
  "preferNameDirectory": true,
  "symbols": {
    "productName": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "",
      "description": "Raw product name used in paths and assembly metadata. When omitted, --name supplies it."
    },
    "productNameTrimmed": {
      "type": "generated",
      "generator": "regex",
      "dataType": "string",
      "parameters": { "source": "productName", "steps": [ { "regex": "^\\s+|\\s+$", "replacement": "" } ] }
    },
    "effectiveName": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": { "sourceVariableName": "productNameTrimmed", "fallbackVariableName": "name" },
      "replaces": "ConsoleProduct",
      "fileRename": "ConsoleProduct"
    },
    "effectiveNameLower": {
      "type": "generated",
      "generator": "casing",
      "parameters": { "source": "effectiveName", "toLower": true },
      "replaces": "consoleproduct"
    },
    "rootNamespace": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "",
      "description": "Optional valid F# identifier supplied by an SDD provider."
    },
    "rootNamespaceTrimmed": {
      "type": "generated",
      "generator": "regex",
      "dataType": "string",
      "parameters": { "source": "rootNamespace", "steps": [ { "regex": "^\\s+|\\s+$", "replacement": "" } ] }
    },
    "effectiveIdentifier": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": { "sourceVariableName": "rootNamespaceTrimmed", "fallbackVariableName": "effectiveName" },
      "replaces": "ConsoleProductNamespace"
    }
  }
}
