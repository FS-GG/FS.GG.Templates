<Project Sdk="Microsoft.NET.Sdk">

  <!-- Packs the `dotnet new` templates under templates/ into a single NuGet template
       package. Installing the package (`dotnet new install FS.GG.Templates`) makes
       `fs-gg-governance` available and, crucially, updatable: `dotnet new update`
       checks the feed and upgrades to the latest published version. This is the
       update function for consumers. -->
  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>FS.GG.Workspace.Template</PackageId>
    <!-- 0.8.2 → 0.8.3 because FS.GG.Templates#418 changes the generated fable-game workspace
         while 0.8.2 is already public; leaving the version unchanged would give two package
         payloads one identity. The integrity checks and generated-output exclusions are
         additive hardening and do not change a template identity or parameter, so PATCH is
         sufficient. The post-merge dual-feed obligation verifies the complete candidate. -->
    <Version>0.8.3</Version>
    <Title>FS.GG workspace templates</Title>
    <Authors>FS-GG</Authors>
    <Description>dotnet new workspace templates for FS.GG.SDD: governance, production-shaped F# console workspaces, and neutral F# ASP.NET Core plus TypeScript web workspaces.</Description>
    <PackageTags>dotnet-new;templates;fsgg;sdd;governance;console;web;typescript;aspnetcore</PackageTags>
    <PackageProjectUrl>https://github.com/FS-GG/FS.GG.Templates</PackageProjectUrl>
    <RepositoryUrl>https://github.com/FS-GG/FS.GG.Templates</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <TargetFramework>net10.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <!-- Template content includes dotfolders (.fsgg, .template.config, .specify, .agents). -->
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <!-- NU5128: no lib/deps in a template package. NU5110/NU5111: vendored .specify
         PowerShell files are template *content*, not NuGet install scripts. -->
    <NoWarn>$(NoWarn);NU5128;NU5110;NU5111</NoWarn>

    <!-- FS-GG/.github#7 / Feature 211 parity: lock restore for org-wide uniformity and as a
         forward guardrail. This packaging project has NO PackageReferences today, so the
         committed packages.lock.json is empty — the load-bearing FS.GG.UI.* enforcement for
         *scaffolded* apps lives upstream in the rendering template (Feature 204/211) and the
         scaffold path, not here. If a real dependency is ever added, locked restore forces the
         lockfile update to be committed instead of silently drifting. Gated on GITHUB_ACTIONS +
         an existing lockfile so a fresh local clone bootstraps the lockfile instead of failing.
         These props live on the csproj (not a root Directory.Build.props) so they never leak
         into the template *content* projects under templates/. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(GITHUB_ACTIONS)' == 'true' And Exists('$(MSBuildProjectDirectory)/packages.lock.json')">true</RestoreLockedMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1603;NU1608</WarningsAsErrors>
  </PropertyGroup>

  <!-- `NoDefaultExcludes` above is `true` on purpose (template content really is dotfolders: .fsgg,
       .template.config, .specify, .agents), so NOTHING is filtered here except what this `Exclude`
       names. The two additions beyond bin/obj are the restore/install output that the template
       directories — which are working solutions, not inert file trees — produce IN PLACE when a
       maintainer runs the regeneration commands their own READMEs document (FS.GG.Templates#386):
       `.nuget/` from each template's `<RestorePackagesPath>` (#380/#382/#384; 118M for fable-game,
       75M for web) and `node_modules/` from `npm install` in either npm workspace. Without these,
       a local `dotnet pack` after the documented maintenance action packs that tree into the
       artifact — measured, not predicted: it produced
       `content/templates/fs-gg-fable-game/.nuget/packages/…` entries plus NU5100 for each packed
       assembly. CI is not what protected the published package (no CI job restores or installs
       inside `templates/`, and the release gate packs from a clean checkout), so this is the rule
       that makes a local pack safe. Kept in lockstep with the `.gitignore` entries and with every
       template's `sources.exclude`; `tests/composition/lib/content-exclusions.sh` seeds both trees
       and reds if any of the three legs stops filtering. -->
  <ItemGroup>
    <Content Include="templates/**/*"
             Exclude="templates/**/bin/**;templates/**/obj/**;templates/**/.nuget/**;templates/**/node_modules/**" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <Compile Remove="**/*" />
  </ItemGroup>

  <!-- ── Owner-sourced product skills (FS.GG.Templates#347) ──────────────────────────────────
       The six generic Fable product skills and their producer manifest are AUTHORED ONCE, under
       `template/product-skills/` and `template/skill-manifest/`, and PROJECTED from there into
       each provider template's shipped `.agents/skills/` payload by the package items below.

       WHY PACKAGE ITEMS AND NOT A CHECKED-IN COPY UNDER templates/. #347's acceptance is that
       "skills are sourced from their owner package rather than copied into a provider template",
       and the copy is the failure mode this repo has already paid for once: before this block,
       `skills/fable-bindings/SKILL.md` and
       `templates/fs-gg-fable-bindings/.agents/skills/fable-bindings/SKILL.md` were two checked-in
       files with one blob, kept equal by a `cmp` in the composition lane — i.e. a second source of
       truth held in place by a test. Projecting at pack time means there is exactly ONE authored
       file per skill and no second file that CAN drift, so the digest in the manifest is a fact
       about the only copy there is.

       WHY THE `templates/**/*` CONTENT GLOB ABOVE DOES NOT COVER THEM. That glob packs the
       `templates/` tree; the owner catalog lives in the sibling `template/` tree, which no package
       item referenced at all. A packed/installed product therefore received NONE of the six
       declared skills, and the manifest was a repository file rather than the product manifest
       the `manifest` arm of `skill-union-assert` reads. These items close exactly that gap; the layout
       is `content/templates/<templateId>/.agents/skills/<id>/SKILL.md`, matching the layout the
       glob above produces for the rest of each template's payload.

       `.agents/skills/` ONLY, deliberately: it is the producer root (`resolvablePath` in the
       manifest, and the root that assertion reads); the `.claude` twin is
       materialized downstream by the scaffolding lane, per ADR-0065. This mirrors what
       `fs-gg-fable-bindings` already shipped.

       COHERENCE IS ENFORCED, NOT ASSERTED IN PROSE: the `check` arm of
       `scripts/generate-skill-manifest.fsx` parses THIS ItemGroup and reds if the projected set,
       its destinations, or the manifest disagree with the generator's catalog. Add a skill in one
       place and the check names the other two. The `Error` target below is the cheap always-on
       half: a skill authored with no package item would otherwise pack into no template at all,
       and reach no product, while every source-side check stayed green. -->
  <ItemGroup>
    <None Include="template/product-skills/fable-project/SKILL.md" Pack="true"
          PackagePath="content/templates/fs-gg-fable-game/.agents/skills/fable-project/;content/templates/fs-gg-fable-bindings/.agents/skills/fable-project/" />
    <None Include="template/product-skills/fable-interop/SKILL.md" Pack="true"
          PackagePath="content/templates/fs-gg-fable-game/.agents/skills/fable-interop/;content/templates/fs-gg-fable-bindings/.agents/skills/fable-interop/" />
    <None Include="template/product-skills/fable-remoting/SKILL.md" Pack="true"
          PackagePath="content/templates/fs-gg-fable-game/.agents/skills/fable-remoting/" />
    <None Include="template/product-skills/fable-signalr/SKILL.md" Pack="true"
          PackagePath="content/templates/fs-gg-fable-game/.agents/skills/fable-signalr/" />
    <None Include="template/product-skills/fable-testing/SKILL.md" Pack="true"
          PackagePath="content/templates/fs-gg-fable-game/.agents/skills/fable-testing/;content/templates/fs-gg-fable-bindings/.agents/skills/fable-testing/" />
    <None Include="template/product-skills/fable-bindings/SKILL.md" Pack="true"
          PackagePath="content/templates/fs-gg-fable-bindings/.agents/skills/fable-bindings/" />
    <!-- One canonical producer manifest per product. It is the upper-bound catalog
         the `manifest` arm of `skill-union-assert` compares a materialized union against, so a row's
         `materializes-when` — not a per-template subset file — is what says where a skill lands. -->
    <None Include="template/skill-manifest/skill-manifest.json" Pack="true"
          PackagePath="content/templates/fs-gg-fable-game/.agents/skills/;content/templates/fs-gg-fable-bindings/.agents/skills/" />
  </ItemGroup>

  <Target Name="FsggVerifyProductSkillSources" BeforeTargets="Build;Pack">
    <ItemGroup>
      <!-- Globbed, not listed: the point is to compare what is ON DISK against what the items
           above name. Re-listing the same six paths here would make this target agree with the
           ItemGroup by construction and observe nothing. -->
      <_FsggOwnerSkill Include="template/product-skills/*/SKILL.md" />
      <_FsggOwnerManifest Include="template/skill-manifest/skill-manifest.json" />
      <_FsggProjectedSkill Include="@(None)"
                           Condition="'%(None.Pack)' == 'true' And $([System.String]::Copy('%(None.Identity)').StartsWith('template/product-skills/'))" />
    </ItemGroup>
    <Error Condition="'@(_FsggOwnerManifest)' == ''"
           Text="template/skill-manifest/skill-manifest.json is missing, so every packed product would ship an unreadable producer manifest. Run: dotnet fsi scripts/generate-skill-manifest.fsx" />
    <Error Condition="'@(_FsggOwnerSkill->Count())' != '@(_FsggProjectedSkill->Count())'"
           Text="Owner-sourced product skills on disk (@(_FsggOwnerSkill->Count())) and product-skill package items (@(_FsggProjectedSkill->Count())) disagree. A skill authored under template/product-skills/ with no package item is packed into NO template and silently reaches no product. Reconcile FS.GG.Templates.csproj with scripts/generate-skill-manifest.fsx, then run `dotnet fsi scripts/generate-skill-manifest.fsx --check`." />
  </Target>

</Project>
